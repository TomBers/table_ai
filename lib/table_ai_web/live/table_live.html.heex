<.simple_form for={@form} phx-submit="save" phx-change="edit">
  <.input name="query" value="" id={@query_id} label="Enter your question" />
</.simple_form>
<.link href={~p"/file/#{@file_name}"}>View File</.link>
<br />
<br />

<%= if length(@nlp_query.errors) > 0 do %>
  <p>
    There are <%= length(@nlp_query.errors) %> errors in the data, you can either skip rows or autofix them.
  </p>
  <br />
  <.button phx-click="skip" phx-value="skip" class="btn btn-primary">Skip</.button>
  <.button phx-click="autofix" phx-value="autofix" class="btn btn-primary">Autofix</.button>
  <br />
<% end %>
<%= if length(@rows) > 0 do %>
  <p>There are <%= length(@rows) %> results for the query.</p>
<% end %>

<.dynamic_table id="rows" rows={@rows} cols={@nlp_query.headers}></.dynamic_table>
